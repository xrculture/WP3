@model string
@{
    ViewData["Title"] = "Open Selected Model";
    var viewer = ViewData["viewer"] as string;
    var error = ViewData["error"] as string;
}
@if (!string.IsNullOrEmpty(error))
{
    <p>Failed: @error</p>
}
else
{
    var viewerUrl = Model;
    var isHttp = viewerUrl?.StartsWith("http://", StringComparison.OrdinalIgnoreCase) == true;

    @if (isHttp)
    {
        <p>
            The viewer is served over HTTP and cannot be embedded in this HTTPS page.<br />
            <a href="@viewerUrl" target="_blank" rel="noopener"
               style="display:inline-block;margin-top:.5rem;padding:.5rem 1.25rem;background:var(--accent,#4f46e5);color:#fff;border-radius:.375rem;text-decoration:none;">
                Open @viewer in a new tab
            </a>
        </p>
        <script>window.open(@Json.Serialize(viewerUrl), '_blank', 'noopener');</script>
    }
    else
    {
        <iframe src="@viewerUrl" title="@viewer" width="100%" height="500px" loading="lazy" allowfullscreen style="border:none;"></iframe>
    }
}
