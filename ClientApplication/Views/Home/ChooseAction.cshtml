@model Europeana3D.Web.Models.ChooseActionViewModel
@{
    ViewData["Title"] = "Choose Action";
}

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const radios = document.querySelectorAll('input[name="SelectedAction"]');
        const viewersDiv = document.getElementById("viewers");
        const oEmbedLabel = document.getElementById("oEmbed-label");
        const viewerSelect = document.getElementById("viewer");

        const allViewers = [
            @foreach (var v in Model.Viewers)
            {
                @:{ id: "@v.ProviderID", name: "@v.DisplayName", oEmbed: @(v.oEmbed ? "true" : "false") },
            }
        ];

        const hasOEmbed = allViewers.some(v => v.oEmbed === true);
        if (hasOEmbed) {
            oEmbedLabel.style.display = "";
        }

        function populateViewers(oEmbedOnly) {
            viewerSelect.innerHTML = "";
            const filtered = oEmbedOnly ? allViewers.filter(v => v.oEmbed === true) : allViewers;
            if (filtered.length === 0) {
                const opt = document.createElement("option");
                opt.textContent = "No compatible viewer";
                opt.disabled = true;
                viewerSelect.appendChild(opt);
            } else {
                filtered.forEach(v => {
                    const opt = document.createElement("option");
                    opt.value = v.id;
                    opt.textContent = v.name;
                    viewerSelect.appendChild(opt);
                });
            }
        }

        function updateUI() {
            const selected = document.querySelector('input[name="SelectedAction"]:checked');
            if (!selected) return;

            if (selected.value === "download") {
                viewersDiv.style.display = "none";
            } else if (selected.value === "viewer") {
                viewersDiv.style.display = "block";
                populateViewers(false);
            } else if (selected.value === "oEmbed") {
                viewersDiv.style.display = "block";
                populateViewers(true);
            }
        }

        updateUI();

        radios.forEach(radio => {
            radio.addEventListener("change", updateUI);
        });
    });
</script>


<div class="choose">
    <img src="@Model.Preview" alt="preview" />
    <h2>@Model.Title</h2>


    <form method="post">
        <input type="hidden" asp-for="EuropeanaId" />
        <input type="hidden" asp-for="SelectedUrl" />
        <input type="hidden" asp-for="FileSize" />
        <input type="hidden" asp-for="FileExtension" />
        <fieldset>
            <legend>Action</legend>
            <label>
                <input type="radio" name="SelectedAction" value="download" checked /> Download the model
            </label>
            <label>
                <input type="radio" name="SelectedAction" value="viewer" /> Open in a viewer
            </label>
            <label id="oEmbed-label" style="display:none">
                <input type="radio" name="SelectedAction" value="oEmbed" /> oEmbed endpoint
            </label>
        </fieldset>


        <div id="viewers" style="display:none">
            @if (!Model.Viewers.Any())
            {
                <p>No compatible 3D viewers were found.</p>
            }
            else
            {
                <label for="viewer">Viewer</label>
                <select id="viewer" name="SelectedViewerProviderId"></select>
            }
        </div>

        <div style="margin-top:1.5rem">
            <button type="submit" >Proceed</button>
            @if (!string.IsNullOrEmpty(Model.ZenodoRecordId))
            {
                    <button type="button" id="btn-metadata"
                            style="display:none;padding:.45rem 1rem;border:1px solid #6366f1;background:transparent;color:#6366f1;border-radius:var(--radius-md);cursor:pointer;font-size:.9rem;float:inline-end;">
                        View Metadata
                    </button>
            }
        </div>
        
    </form>
</div>

@if (!string.IsNullOrEmpty(Model.ZenodoRecordId))
{
    <script>
    (function () {
        const zenodoRecordId = @Json.Serialize(Model.ZenodoRecordId);
        const selectedUrl = @Json.Serialize(Model.SelectedUrl ?? "");
        const checkMetadataUrl = @Json.Serialize(Url.Action("CheckMetadata", "Home", new { zenodoRecordId = Model.ZenodoRecordId, accessToken = Model.AccessToken }));
        const modelMetadataBaseUrl = @Json.Serialize(Url.Action("ModelMetadata", "Home", new { zenodoRecordId = Model.ZenodoRecordId, accessToken = Model.AccessToken }));

        const btnMeta = document.getElementById('btn-metadata');
        if (!btnMeta || !zenodoRecordId) return;

        function pidFromUrl(url) {
            const m = url.match(/\/files\/([^/?#]+?)(?:\/content)?(?:[?#]|$)/i);
            if (!m) return '';
            const filename = decodeURIComponent(m[1]);
            const dot = filename.lastIndexOf('.');
            return dot > 0 ? filename.substring(0, dot) : filename;
        }

        const pid = pidFromUrl(selectedUrl);
        if (!pid) return;

        fetch(checkMetadataUrl)
            .then(function (r) { return r.json(); })
            .then(function (exists) { if (exists) btnMeta.style.display = ''; })
            .catch(function () {});

        btnMeta.addEventListener('click', function () {
            window.open(modelMetadataBaseUrl + '&pid=' + encodeURIComponent(pid), '_blank');
        });
    })();
    </script>
}